<Window x:Class="szabo_filmek.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:szabo_filmek"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <GroupBox Grid.Column="0">
            <StackPanel>
                <Button Content="Filmek betöltése" Margin="10" Click="filmek_betoltese"/>
                <Button Content="Hány film van?" Margin="10" Click="hany_film_van"/>
                <Button Content="Melyik a leghosszabb film?" Margin="10" Click="leghosszabb_film" />
                <Button Content="Átlag értékelés" Margin="10" Click="atlagos_ertekeles" />
                <Button Content="Csak sci-fi" Margin="10" Click="csak_scifi"/>
                <Button Content="Csak címek" Margin="10" Click="csak_cimek"/>
                <Button Content="Rendezés cím szerint" Margin="10" Click="rendezes_cim_szerint"/>
                <ProgressBar Height="20" Margin="10" Maximum="100" Minimum="0" Value="15"/>
            </StackPanel>
        </GroupBox>
        <GroupBox Grid.Column="1">
            <StackPanel>
                <DataGrid x:Name="filmekdtg" AutoGenerateColumns="True">

                </DataGrid>
            </StackPanel>
        </GroupBox>
    </Grid>
</Window>
